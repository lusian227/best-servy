// PART 3: EVENT BUS WITH OUTBOX INTEGRATION
// ============================================

// src/core/events/EventBus.ts
import { DomainEvent } from './DomainEvent';
import { Outbox } from '../outbox/Outbox';
import { Logger } from '../logging/Logger';
import { Metrics } from '../metrics/Metrics';

export interface EventHandler<T extends DomainEvent = DomainEvent> {
  handle(event: T): Promise<void>;
  priority?: number;
}

export class EventBus {
  private handlers: Map<string, EventHandler[]> = new Map();
  private outbox?: Outbox;
  private logger?: Logger;
  private metrics?: Metrics;

  constructor(options?: {
    outbox?: Outbox;
    logger?: Logger;
    metrics?: Metrics;
  }) {
    this.outbox = options?.outbox;
    this.logger = options?.logger;
    this.metrics = options?.metrics;
  }

  subscribe<T extends DomainEvent>(eventType: string, handler: EventHandler<T>): () => void {
    if (!this.handlers.has(eventType)) {
      this.handlers.set(eventType, []);
    }
    this.handlers.get(eventType)!.push(handler);

    return () => {
      const handlers = this.handlers.get(eventType)!;
      const index = handlers.indexOf(handler);
      if (index !== -1) {
        handlers.splice(index, 1);
      }
    };
  }

  async publish(event: DomainEvent): Promise<void> {
    this.logger?.debug(Publishing event: , {
      aggregateId: event.aggregateId,
      aggregateType: event.aggregateType,
    });

    // Save to outbox if available
    if (this.outbox) {
      await this.outbox.save(event);
      this.metrics?.increment('event.outbox.saved', 1);
    }

    // Publish to handlers (synchronous)
    const handlers = this.handlers.get(event.eventType) || [];
    handlers.sort((a, b) => (b.priority || 0) - (a.priority || 0));

    await Promise.allSettled(
      handlers.map(async (handler) => {
        try {
          await handler.handle(event);
          this.metrics?.increment('event.handler.success', 1, {
            eventType: event.eventType,
          });
        } catch (error) {
          this.logger?.error(Handler failed for , error);
          this.metrics?.increment('event.handler.error', 1, {
            eventType: event.eventType,
          });
        }
      })
    );

    this.metrics?.increment('event.published', 1, {
      eventType: event.eventType,
    });
  }

  async publishBatch(events: DomainEvent[]): Promise<void> {
    for (const event of events) {
      await this.publish(event);
    }
  }
}

// ============================================
// PART 4: PIPELINE BEHAVIORS (Cross-Cutting)
// ============================================

// src/core/pipeline/PipelineBehavior.ts
import { RequestContext } from '../context/RequestContext';
import { Result } from '../result/Result';
import { DomainError } from '../domain/DomainError';
import { Logger } from '../logging/Logger';
import { Metrics } from '../metrics/Metrics';

export interface PipelineBehavior<TCommand, TResult> {
  handle(
    command: TCommand,
    context: RequestContext,
    next: () => Promise<Result<TResult, DomainError>>
  ): Promise<Result<TResult, DomainError>>;
}

export class LoggingBehavior<TCommand, TResult> implements PipelineBehavior<TCommand, TResult> {
  constructor(private logger: Logger) {}

  async handle(
    command: TCommand,
    context: RequestContext,
    next: () => Promise<Result<TResult, DomainError>>
  ): Promise<Result<TResult, DomainError>> {
    const commandName = command.constructor.name;
    this.logger.debug(Executing command: , {
      correlationId: context.correlationId,
      userId: context.userId,
    });

    const startTime = Date.now();
    const result = await next();
    const duration = Date.now() - startTime;

    this.logger.debug(Command completed: , {
      correlationId: context.correlationId,
      duration,
      success: result.isSuccess(),
    });

    return result;
  }
}

export class ValidationBehavior<TCommand, TResult> implements PipelineBehavior<TCommand, TResult> {
  constructor(private validator: (command: TCommand) => Result<void, DomainError>) {}

  async handle(
    command: TCommand,
    context: RequestContext,
    next: () => Promise<Result<TResult, DomainError>>
  ): Promise<Result<TResult, DomainError>> {
    const validationResult = this.validator(command);
    if (validationResult.isFailure()) {
      return validationResult as Result<TResult, DomainError>;
    }
    return next();
  }
}

export class AuthorizationBehavior<TCommand, TResult> implements PipelineBehavior<TCommand, TResult> {
  constructor(
    private policy: (command: TCommand, context: RequestContext) => Result<void, DomainError>
  ) {}

  async handle(
    command: TCommand,
    context: RequestContext,
    next: () => Promise<Result<TResult, DomainError>>
  ): Promise<Result<TResult, DomainError>> {
    const authResult = this.policy(command, context);
    if (authResult.isFailure()) {
      return authResult as Result<TResult, DomainError>;
    }
    return next();
  }
}

export class MetricsBehavior<TCommand, TResult> implements PipelineBehavior<TCommand, TResult> {
  constructor(private metrics: Metrics) {}

  async handle(
    command: TCommand,
    context: RequestContext,
    next: () => Promise<Result<TResult, DomainError>>
  ): Promise<Result<TResult, DomainError>> {
    const commandName = command.constructor.name;
    const startTime = Date.now();
    
    const result = await next();
    
    const duration = Date.now() - startTime;
    this.metrics.record(command..duration, duration);
    this.metrics.increment(command.., 1);

    return result;
  }
}


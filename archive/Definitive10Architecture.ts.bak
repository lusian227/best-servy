// src/core/context/RequestContext.ts
export class RequestContext {
  private readonly _userId: string;
  private readonly _companyId: string;
  private readonly _workspaceId?: string;
  private readonly _roles: readonly string[];
  private readonly _permissions: readonly string[];
  private readonly _correlationId: string;
  private readonly _tenantId: string;
  private readonly _ipAddress?: string;
  private readonly _userAgent?: string;
  private readonly _sessionId?: string;

  constructor(props: {
    userId: string;
    companyId: string;
    workspaceId?: string;
    roles?: string[];
    permissions?: string[];
    correlationId?: string;
    tenantId?: string;
    ipAddress?: string;
    userAgent?: string;
    sessionId?: string;
  }) {
    this._userId = props.userId;
    this._companyId = props.companyId;
    this._workspaceId = props.workspaceId;
    this._roles = Object.freeze([...(props.roles || [])]);
    this._permissions = Object.freeze([...(props.permissions || [])]);
    this._correlationId = props.correlationId || crypto.randomUUID();
    this._tenantId = props.tenantId || props.companyId;
    this._ipAddress = props.ipAddress;
    this._userAgent = props.userAgent;
    this._sessionId = props.sessionId;
  }

  get userId(): string { return this._userId; }
  get companyId(): string { return this._companyId; }
  get workspaceId(): string | undefined { return this._workspaceId; }
  get roles(): readonly string[] { return this._roles; }
  get permissions(): readonly string[] { return this._permissions; }
  get correlationId(): string { return this._correlationId; }
  get tenantId(): string { return this._tenantId; }
  get ipAddress(): string | undefined { return this._ipAddress; }
  get userAgent(): string | undefined { return this._userAgent; }
  get sessionId(): string | undefined { return this._sessionId; }

  hasPermission(permission: string): boolean {
    return this._permissions.includes(permission);
  }

  hasRole(role: string): boolean {
    return this._roles.includes(role);
  }

  withWorkspace(workspaceId: string): RequestContext {
    return new RequestContext({
      userId: this._userId,
      companyId: this._companyId,
      workspaceId,
      roles: [...this._roles],
      permissions: [...this._permissions],
      correlationId: this._correlationId,
      tenantId: this._tenantId,
      ipAddress: this._ipAddress,
      userAgent: this._userAgent,
      sessionId: this._sessionId,
    });
  }

  withPermissions(permissions: string[]): RequestContext {
    return new RequestContext({
      userId: this._userId,
      companyId: this._companyId,
      workspaceId: this._workspaceId,
      roles: [...this._roles],
      permissions,
      correlationId: this._correlationId,
      tenantId: this._tenantId,
      ipAddress: this._ipAddress,
      userAgent: this._userAgent,
      sessionId: this._sessionId,
    });
  }
}

// src/core/result/Result.ts
export type Result<T, E = DomainError> = Success<T, E> | Failure<T, E>;

export class Success<T, E> {
  constructor(public readonly value: T) {}
  isSuccess(): this is Success<T, E> { return true; }
  isFailure(): this is Failure<T, E> { return false; }
  getValue(): T { return this.value; }
  getError(): never { throw new Error('Cannot get error from success'); }
  map<U>(fn: (value: T) => U): Result<U, E> {
    return new Success(fn(this.value));
  }
  flatMap<U>(fn: (value: T) => Result<U, E>): Result<U, E> {
    return fn(this.value);
  }
  onSuccess(fn: (value: T) => void): Result<T, E> {
    fn(this.value);
    return this;
  }
  onFailure(fn: (error: E) => void): Result<T, E> {
    return this;
  }
}

export class Failure<T, E> {
  constructor(public readonly error: E) {}
  isSuccess(): this is Success<T, E> { return false; }
  isFailure(): this is Failure<T, E> { return true; }
  getValue(): never { throw new Error('Cannot get value from failure'); }
  getError(): E { return this.error; }
  map<U>(fn: (value: T) => U): Result<U, E> {
    return new Failure(this.error);
  }
  flatMap<U>(fn: (value: T) => Result<U, E>): Result<U, E> {
    return new Failure(this.error);
  }
  onSuccess(fn: (value: T) => void): Result<T, E> {
    return this;
  }
  onFailure(fn: (error: E) => void): Result<T, E> {
    fn(this.error);
    return this;
  }
}

export const success = <T, E>(value: T): Result<T, E> => new Success(value);
export const failure = <T, E>(error: E): Result<T, E> => new Failure(error);

// src/core/domain/DomainError.ts
export abstract class DomainError {
  abstract readonly code: string;
  abstract readonly message: string;
  abstract readonly details?: Record<string, any>;
  readonly timestamp: Date = new Date();
  readonly correlationId?: string;
}

export class ValidationError extends DomainError {
  readonly code = 'VALIDATION_ERROR';
  constructor(
    public readonly message: string,
    public readonly details?: Record<string, any>,
    public readonly correlationId?: string
  ) { super(); }
}

export class NotFoundError extends DomainError {
  readonly code = 'NOT_FOUND';
  constructor(
    public readonly message: string,
    public readonly details?: Record<string, any>,
    public readonly correlationId?: string
  ) { super(); }
}

export class PermissionError extends DomainError {
  readonly code = 'PERMISSION_DENIED';
  constructor(
    public readonly message: string,
    public readonly details?: Record<string, any>,
    public readonly correlationId?: string
  ) { super(); }
}

export class ConcurrencyError extends DomainError {
  readonly code = 'CONCURRENCY_ERROR';
  constructor(
    public readonly message: string,
    public readonly details?: Record<string, any>,
    public readonly correlationId?: string
  ) { super(); }
}

export class BusinessRuleError extends DomainError {
  readonly code = 'BUSINESS_RULE_VIOLATION';
  constructor(
    public readonly message: string,
    public readonly details?: Record<string, any>,
    public readonly correlationId?: string
  ) { super(); }
}


// ============================================

// src/core/outbox/Outbox.ts
import { DomainEvent } from '../events/EventBus';
import { supabase } from '../../lib/supabase';

export interface OutboxMessage {
  id: string;
  eventType: string;
  aggregateId: string;
  aggregateType: string;
  payload: any;
  occurredAt: Date;
  status: 'pending' | 'processing' | 'completed' | 'failed';
  retryCount: number;
  maxRetries: number;
  nextRetryAt: Date;
  error?: string;
  createdAt: Date;
  updatedAt: Date;
}

export class Outbox {
  private readonly table = 'outbox_messages';

  async save(event: DomainEvent): Promise<void> {
    const message: OutboxMessage = {
      id: crypto.randomUUID(),
      eventType: event.eventType,
      aggregateId: event.aggregateId,
      aggregateType: event.aggregateType,
      payload: event,
      occurredAt: event.occurredAt,
      status: 'pending',
      retryCount: 0,
      maxRetries: 3,
      nextRetryAt: new Date(),
      createdAt: new Date(),
      updatedAt: new Date(),
    };

    const { error } = await supabase
      .from(this.table)
      .insert(message);

    if (error) throw error;
  }

  async getPendingMessages(limit: number = 100): Promise<OutboxMessage[]> {
    const { data, error } = await supabase
      .from(this.table)
      .select('*')
      .eq('status', 'pending')
      .lt('next_retry_at', new Date().toISOString())
      .order('created_at', { ascending: true })
      .limit(limit);

    if (error || !data) return [];
    return data;
  }

  async markProcessing(id: string): Promise<void> {
    const { error } = await supabase
      .from(this.table)
      .update({
        status: 'processing',
        updated_at: new Date().toISOString(),
      })
      .eq('id', id);

    if (error) throw error;
  }

  async markCompleted(id: string): Promise<void> {
    const { error } = await supabase
      .from(this.table)
      .update({
        status: 'completed',
        updated_at: new Date().toISOString(),
      })
      .eq('id', id);

    if (error) throw error;
  }

  async markFailed(id: string, error: string): Promise<void> {
    const { data: message } = await supabase
      .from(this.table)
      .select('*')
      .eq('id', id)
      .single();

    if (!message) return;

    const retryCount = (message.retry_count || 0) + 1;
    const nextRetryAt = new Date(Date.now() + Math.pow(2, retryCount) * 1000);

    const { error: updateError } = await supabase
      .from(this.table)
      .update({
        status: retryCount >= 3 ? 'failed' : 'pending',
        retry_count: retryCount,
        next_retry_at: retryCount >= 3 ? null : nextRetryAt.toISOString(),
        error: error,
        updated_at: new Date().toISOString(),
      })
      .eq('id', id);

    if (updateError) throw updateError;
  }
}

// src/core/outbox/OutboxProcessor.ts
import { Outbox } from './Outbox';
import { EventBus } from '../events/EventBus';
import { Logger } from '../logging/Logger';
import { Metrics } from '../metrics/Metrics';

export class OutboxProcessor {
  private isRunning: boolean = false;
  private interval: NodeJS.Timeout | null = null;
  private readonly pollInterval: number = 5000;
  private readonly batchSize: number = 100;

  constructor(
    private outbox: Outbox,
    private eventBus: EventBus,
    private logger: Logger,
    private metrics: Metrics
  ) {}

  start(): void {
    if (this.isRunning) return;
    this.isRunning = true;
    this.logger.info('OutboxProcessor started');
    this.processBatch();
    this.interval = setInterval(() => this.processBatch(), this.pollInterval);
  }

  stop(): void {
    this.isRunning = false;
    if (this.interval) {
      clearInterval(this.interval);
      this.interval = null;
    }
    this.logger.info('OutboxProcessor stopped');
  }

  private async processBatch(): Promise<void> {
    if (!this.isRunning) return;

    try {
      const messages = await this.outbox.getPendingMessages(this.batchSize);
      
      if (messages.length === 0) return;

      this.logger.debug(Processing  outbox messages);

      for (const message of messages) {
        await this.processMessage(message);
      }
    } catch (error) {
      this.logger.error('Error processing outbox batch', error);
      this.metrics.increment('outbox.batch.error', 1);
    }
  }

  private async processMessage(message: any): Promise<void> {
    try {
      await this.outbox.markProcessing(message.id);

      // Publish event
      await this.eventBus.publish(message.payload);

      await this.outbox.markCompleted(message.id);
      
      this.metrics.increment('outbox.message.processed', 1);
      this.metrics.record('outbox.message.latency', 
        Date.now() - new Date(message.created_at).getTime()
      );
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      await this.outbox.markFailed(message.id, errorMessage);
      this.metrics.increment('outbox.message.failed', 1);
      
      this.logger.error(Failed to process outbox message , error);
    }
  }
}


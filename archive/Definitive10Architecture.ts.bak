// src/core/modules/Module.ts
export interface Module {
  name: string;
  version: string;
  dependencies: string[];
  commands: string[];
  queries: string[];
  events: string[];
  onActivate?: () => Promise<void>;
  onDeactivate?: () => Promise<void>;
}

export class ModuleRegistry {
  private modules: Map<string, Module> = new Map();

  register(module: Module): void {
    if (this.modules.has(module.name)) {
      throw new Error(Module  already registered);
    }
    this.modules.set(module.name, module);
  }

  get(name: string): Module | undefined {
    return this.modules.get(name);
  }

  getAll(): Module[] {
    return Array.from(this.modules.values());
  }

  getDependencies(name: string): string[] {
    const module = this.modules.get(name);
    if (!module) return [];
    return module.dependencies;
  }
}

// ============================================
// PART 10: COMPLETE CONTAINER
// ============================================

// src/application/Container.ts
import { EventBus } from '../core/events/EventBus';
import { Outbox } from '../core/outbox/Outbox';
import { OutboxProcessor } from '../core/outbox/OutboxProcessor';
import { SnapshotStore } from '../core/snapshots/SnapshotStore';
import { ProjectionEngine } from '../core/projections/ProjectionEngine';
import { EventUpcasterRegistry } from '../core/events/EventUpcaster';
import { SystemClock } from '../core/clock/Clock';
import { UuidGenerator } from '../core/id/IdGenerator';
import { Logger } from '../core/logging/Logger';
import { Metrics } from '../core/metrics/Metrics';
import { ModuleRegistry } from '../core/modules/Module';

// Domain Repositories
import { SupabaseProjectRepository } from '../domains/project/infrastructure/repositories/SupabaseProjectRepository';

// Application Handlers
import { CreateProjectHandler } from '../domains/project/application/commands/CreateProjectCommand';
import { ListProjectsHandler } from '../domains/project/application/queries/ListProjectsQuery';

// Domain Services
import { ProjectSchedulingService } from '../domains/project/domain/services/ProjectSchedulingService';
import { ProjectRiskAnalysisService } from '../domains/project/domain/services/ProjectRiskAnalysisService';

// Projections
import { ProjectDashboardProjection } from '../domains/project/infrastructure/projections/ProjectDashboardProjection';

// Policies
import { PermissionPolicy } from '../core/policies/PermissionPolicy';

export class ApplicationContainer {
  public eventBus: EventBus;
  public outbox: Outbox;
  public outboxProcessor: OutboxProcessor;
  public snapshotStore: SnapshotStore;
  public projectionEngine: ProjectionEngine;
  public upcasterRegistry: EventUpcasterRegistry;
  public moduleRegistry: ModuleRegistry;
  public logger: Logger;
  public metrics: Metrics;
  public clock: SystemClock;
  public idGenerator: UuidGenerator;

  // Repositories
  public projectRepository: SupabaseProjectRepository;

  // Domain Services
  public projectSchedulingService: ProjectSchedulingService;
  public projectRiskAnalysisService: ProjectRiskAnalysisService;

  // Handlers
  public createProjectHandler: CreateProjectHandler;
  public listProjectsHandler: ListProjectsHandler;

  constructor() {
    // Core
    this.logger = new Logger();
    this.metrics = new Metrics();
    this.clock = new SystemClock();
    this.idGenerator = new UuidGenerator();

    // Outbox
    this.outbox = new Outbox();
    this.outboxProcessor = new OutboxProcessor(
      this.outbox,
      this.eventBus,
      this.logger,
      this.metrics
    );

    // Event Bus
    this.eventBus = new EventBus({
      outbox: this.outbox,
      logger: this.logger,
      metrics: this.metrics,
    });

    // Snapshots
    this.snapshotStore = new SnapshotStore();

    // Projections
    this.projectionEngine = new ProjectionEngine();

    // Upcasters
    this.upcasterRegistry = new EventUpcasterRegistry();

    // Modules
    this.moduleRegistry = new ModuleRegistry();

    // Repositories
    this.projectRepository = new SupabaseProjectRepository();

    // Domain Services
    this.projectSchedulingService = new ProjectSchedulingService();
    this.projectRiskAnalysisService = new ProjectRiskAnalysisService();

    // Handlers
    this.createProjectHandler = new CreateProjectHandler(
      this.projectRepository,
      this.eventBus,
      this.snapshotStore,
      this.clock,
      this.idGenerator
    );
    this.listProjectsHandler = new ListProjectsHandler(
      this.projectRepository
    );

    // Register Projections
    this.projectionEngine.register(new ProjectDashboardProjection());

    // Register Modules
    this.registerModules();

    // Start Outbox Processor
    this.outboxProcessor.start();
  }

  private registerModules(): void {
    this.moduleRegistry.register({
      name: 'project',
      version: '1.0.0',
      dependencies: [],
      commands: ['CreateProject', 'UpdateProject', 'ArchiveProject'],
      queries: ['ListProjects', 'GetProject'],
      events: ['ProjectCreated', 'ProjectUpdated', 'ProjectArchived'],
    });

    // Register other modules as they're built
  }

  createRequestContext(user: any, profile: any): RequestContext {
    return new RequestContext({
      userId: user.id,
      companyId: profile?.company_id || '',
      workspaceId: profile?.workspace_id,
      roles: profile?.roles || [],
      permissions: profile?.permissions || [],
    });
  }
}

// Factory
export function createContainer(): ApplicationContainer {
  return new ApplicationContainer();
}

// ============================================
// PART 11: REACT INTEGRATION
// ============================================

// src/application/AppContainerProvider.tsx
import React, { createContext, useContext, useMemo, ReactNode } from 'react';
import { ApplicationContainer, createContainer } from './Container';

const ContainerContext = createContext<ApplicationContainer | null>(null);

export function AppContainerProvider({ children }: { children: ReactNode }) {
  const container = useMemo(() => createContainer(), []);
  return (
    <ContainerContext.Provider value={container}>
      {children}
    </ContainerContext.Provider>
  );
}

export function useContainer(): ApplicationContainer {
  const context = useContext(ContainerContext);
  if (!context) {
    throw new Error('useContainer must be used within AppContainerProvider');
  }
  return context;
}

// src/main.tsx
import React from 'react';
import ReactDOM from 'react-dom/client';
import { AppContainerProvider } from './application/AppContainerProvider';
import { TenantProvider } from './core/auth/TenantContext';
import App from './App';
import './index.css';

ReactDOM.createRoot(document.getElementById('root')!).render(
  <React.StrictMode>
    <TenantProvider>
      <AppContainerProvider>
        <App />
      </AppContainerProvider>
    </TenantProvider>
  </React.StrictMode>
);

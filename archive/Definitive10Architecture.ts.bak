// PART 5: AGGREGATE SNAPSHOTS
// ============================================

// src/core/snapshots/SnapshotStore.ts
import { AggregateRoot } from '../domain/Entity';
import { supabase } from '../../lib/supabase';

export interface Snapshot<T extends AggregateRoot = AggregateRoot> {
  id: string;
  aggregateId: string;
  aggregateType: string;
  version: number;
  state: T;
  createdAt: Date;
}

export class SnapshotStore {
  private readonly table = 'aggregate_snapshots';

  async save<T extends AggregateRoot>(aggregate: T): Promise<void> {
    const { error } = await supabase
      .from(this.table)
      .upsert({
        aggregate_id: aggregate.id,
        aggregate_type: aggregate.aggregateType,
        version: aggregate.version,
        state: aggregate,
        created_at: new Date().toISOString(),
      });

    if (error) throw error;
  }

  async getLatest<T extends AggregateRoot>(
    aggregateId: string,
    aggregateType: string
  ): Promise<Snapshot<T> | null> {
    const { data, error } = await supabase
      .from(this.table)
      .select('*')
      .eq('aggregate_id', aggregateId)
      .eq('aggregate_type', aggregateType)
      .order('version', { ascending: false })
      .limit(1)
      .single();

    if (error || !data) return null;
    return {
      id: data.id,
      aggregateId: data.aggregate_id,
      aggregateType: data.aggregate_type,
      version: data.version,
      state: data.state,
      createdAt: new Date(data.created_at),
    };
  }

  async getByVersion<T extends AggregateRoot>(
    aggregateId: string,
    aggregateType: string,
    version: number
  ): Promise<Snapshot<T> | null> {
    const { data, error } = await supabase
      .from(this.table)
      .select('*')
      .eq('aggregate_id', aggregateId)
      .eq('aggregate_type', aggregateType)
      .eq('version', version)
      .single();

    if (error || !data) return null;
    return {
      id: data.id,
      aggregateId: data.aggregate_id,
      aggregateType: data.aggregate_type,
      version: data.version,
      state: data.state,
      createdAt: new Date(data.created_at),
    };
  }
}

// ============================================
// PART 6: PROJECTION ENGINE
// ============================================

// src/core/projections/ProjectionEngine.ts
import { DomainEvent } from '../events/EventBus';
import { supabase } from '../../lib/supabase';

export interface Projection<T = any> {
  name: string;
  handle(event: DomainEvent): Promise<void>;
  rebuild(): Promise<void>;
  getState(): Promise<T | null>;
}

export interface ProjectionState {
  projectionName: string;
  lastProcessedEventId: string;
  lastProcessedAt: Date;
  processedCount: number;
  errorCount: number;
  status: 'active' | 'paused' | 'error';
}

export class ProjectionEngine {
  private projections: Projection[] = [];
  private readonly stateTable = 'projection_states';

  register(projection: Projection): void {
    this.projections.push(projection);
  }

  async processEvent(event: DomainEvent): Promise<void> {
    for (const projection of this.projections) {
      try {
        await projection.handle(event);
        await this.updateState(projection.name, event);
      } catch (error) {
        console.error(Projection  failed for event , error);
        await this.updateErrorState(projection.name, error);
      }
    }
  }

  async rebuildProjection(name: string): Promise<void> {
    const projection = this.projections.find(p => p.name === name);
    if (!projection) throw new Error(Projection  not found);

    // Reset state
    await this.resetState(name);

    // Rebuild
    await projection.rebuild();

    // Update state
    await this.updateState(name, null, true);
  }

  async rebuildAll(): Promise<void> {
    for (const projection of this.projections) {
      await this.rebuildProjection(projection.name);
    }
  }

  private async updateState(
    projectionName: string,
    event: DomainEvent | null,
    completed: boolean = false
  ): Promise<void> {
    const { error } = await supabase
      .from(this.stateTable)
      .upsert({
        projection_name: projectionName,
        last_processed_event_id: event?.id || null,
        last_processed_at: event?.occurredAt || new Date(),
        processed_count: completed ? 0 : 1,
        status: 'active',
        updated_at: new Date().toISOString(),
      });

    if (error) throw error;
  }

  private async updateErrorState(projectionName: string, error: any): Promise<void> {
    const { error: updateError } = await supabase
      .from(this.stateTable)
      .update({
        status: 'error',
        error_count: supabase.sqlerror_count + 1,
        updated_at: new Date().toISOString(),
      })
      .eq('projection_name', projectionName);

    if (updateError) throw updateError;
  }

  private async resetState(projectionName: string): Promise<void> {
    const { error } = await supabase
      .from(this.stateTable)
      .upsert({
        projection_name: projectionName,
        last_processed_event_id: null,
        last_processed_at: null,
        processed_count: 0,
        status: 'rebuilding',
        updated_at: new Date().toISOString(),
      });

    if (error) throw error;
  }
}

// ============================================
// PART 7: EVENT UPCASTER (Schema Evolution)
// ============================================

// src/core/events/EventUpcaster.ts
import { DomainEvent } from './DomainEvent';

export interface EventUpcaster {
  canUpcast(event: DomainEvent): boolean;
  upcast(event: DomainEvent): DomainEvent;
  fromVersion: number;
  toVersion: number;
}

export class EventUpcasterRegistry {
  private upcasters: EventUpcaster[] = [];

  register(upcaster: EventUpcaster): void {
    this.upcasters.push(upcaster);
  }

  upcast(event: DomainEvent): DomainEvent {
    let currentEvent = event;
    let upcasterFound = true;

    while (upcasterFound) {
      upcasterFound = false;
      for (const upcaster of this.upcasters) {
        if (upcaster.canUpcast(currentEvent)) {
          currentEvent = upcaster.upcast(currentEvent);
          upcasterFound = true;
          break;
        }
      }
    }

    return currentEvent;
  }
}

